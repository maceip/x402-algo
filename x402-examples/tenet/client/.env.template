# Identifies the user for the operator's per-user sponsorship counter.
USER_ID=user-demo

# --- Wallet mode is chosen automatically ---
# If AVM_MNEMONIC is set, the user has their OWN wallet (self-custody): the
# operator sponsors the first 5 queries, then the user pays from this wallet.
# If AVM_MNEMONIC is empty, the user is MANAGED CUSTODIAL: the operator runs a
# wallet for them (OPERATOR_MNEMONIC) and funds everything.
AVM_MNEMONIC=

# Operator's sponsoring / custodial wallet (funds sponsored + managed queries).
OPERATOR_MNEMONIC=operator 25-word mnemonic here

# Routing hop to send the query through.
HOP_URL=http://localhost:4030

# Operator service that tracks the per-user free-query allowance.
FACILITATOR_URL=http://localhost:4022

# Optional prompt to ask.
# PROMPT=In one sentence, name one Monet painting technique.
